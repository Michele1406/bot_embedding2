# === API Keys ===
GEMINI_API_KEY=la_tua_chiave_api_qui
FLASK_SECRET_KEY=cambiami_in_produzione

# === Modelli LLM (i nomi devono corrispondere a quelli letti da app.py) ===
LLM_PRINCIPALE=models/gemini-3.5-flash
LLM_FALLBACK=models/gemini-3.5-flash-lite
LLM_AUDIO=models/gemini-2.5-flash
LLM_EMBEDDING=models/gemini-embedding-2

# === Percorso dati prodotti (usato dagli script in scripts/) ===
DATA_LAKE_PATH=/percorso/alla/cartella/prodotti

# === Funzionalità opzionali ===
ENABLE_IMPARA=0
# === Collezioni del database vettoriale (default: v2) ===
CATALOGO_COLLECTION=catalogo_v2
RICETTE_COLLECTION=ricette_v2
LLM_RIASSUNTO=models/gemini-3.5-flash-lite

# === Controlli e log ===
GUARDRAIL_OUTPUT=1
AUDIT_LOG=1
# SESSIONI_DB=data/sessioni.db

# === Ordini: gestionale (ERP). Vuoto = gli ordini si salvano in data/ordini/*.json, non vanno a nessun indirizzo esterno ===
ERP_WEBHOOK_URL=

# === Cache embedding delle query (core/embedder.py): EMBEDDING_CACHE=0 per disattivarla ===
# EMBEDDING_CACHE_DB=data/cache_embedding.sqlite
# === Conservazione dati (core/manutenzione.py): giorni di log chat/audit, 0 = non cancellare ===
RETENTION_GIORNI_LOG=30
# ORDINI_DIR=data/ordini

# === WhatsApp Cloud API (spento di default, vedi core/whatsapp.py) ===
WHATSAPP_ENABLED=0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
